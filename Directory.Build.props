<Project>
  <!--
    游戏托管程序集的统一根目录。
    优先用 ADOFAI_LIBS 环境变量（CI 与自定义布局），否则回退到仓库同级的
    adofai-libs（本地标准布局：D:\Projects\adofai-libs）。

    所有 csproj 的 HintPath 必须走 $(AdofaiLibsRoot)，不要再写死
    ..\..\adofai-libs——写死会让「换个目录/CI 布局」变成 30 个 HintPath 的批量改。
  -->
  <PropertyGroup>
    <AdofaiLibsRoot Condition="'$(ADOFAI_LIBS)' != ''">$(ADOFAI_LIBS)</AdofaiLibsRoot>
    <AdofaiLibsRoot Condition="'$(AdofaiLibsRoot)' == ''">$(MSBuildThisFileDirectory)..\adofai-libs</AdofaiLibsRoot>
  </PropertyGroup>
</Project>